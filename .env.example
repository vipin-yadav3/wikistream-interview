# Copy to .env before running the pipeline.
# These JARs are downloaded automatically by Spark on first run (~2-3 min).

PYSPARK_SUBMIT_ARGS="--packages org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.0,io.delta:delta-spark_2.12:3.2.0,org.apache.hadoop:hadoop-aws:3.3.4,com.amazonaws:aws-java-sdk-bundle:1.12.262,org.postgresql:postgresql:42.7.3 pyspark-shell"

KAFKA_BOOTSTRAP=localhost:9092
POSTGRES_URL=jdbc:postgresql://localhost:5432/wikidb
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
